{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "showOnHover": true
        },
        "clock": {
            "showDate": false
        },
        "dragThreshold": 20,
        "persistent": false,
        "showOnHover": true,
        "statusIcons": [
            {
                "id": "lockStatus",
                "enabled": true
            },
            {
                "id": "audio",
                "enabled": true
            },
            {
                "id": "microphone",
                "enabled": false
            },
            {
                "id": "kbLayout",
                "enabled": false
            },
            {
                "id": "network",
                "enabled": true
            },
            {
                "id": "bluetooth",
                "enabled": true
            },
            {
                "id": "battery",
                "enabled": true
            }
        ]
    },
    "border": {
        "rounding": 0,
        "thickness": 0
    },
    "general": {
        "idle": {
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 180
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 210
                },
                {
                    "idleAction": [
                        "suspendThenHibernate"
                    ],
                    "timeout": 300
                }
            ]
        }
    },
    "services": {
        "audioIncrement": 0.05,
        "brightnessIncrement": 0.02,
        "gpuType": "GENERIC"
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
        "toasts": {
            "audioInputChanged": false,
            "audioOutputChanged": false,
            "capsLockChanged": true,
            "kbLayoutChanged": false
        }
    }
}
