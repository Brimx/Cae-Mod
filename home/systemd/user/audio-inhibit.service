[Unit]
Description=Inhibit idle while any window is playing/capturing audio
After=graphical-session.target suspend.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/audio-inhibit.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
