(
    charge_control_end_threshold: 80,
    base_charge_control_end_threshold: 80,
    disable_nvidia_powerd_on_battery: true,
    # ppd (via Caelestia) es dueno unico de platform_profile y EPP.
    # asusd se queda con curvas de ventilador y tunings; no_turbo lo lleva
    # asus-turbo-guard segun bateria + perfil. Si asusd tambien escribe,
    # gana el ultimo y aparecen desync (EPP balance_performance en quiet).
    ac_command: "",
    bat_command: "",
    platform_profile_linked_epp: false,
    platform_profile_on_battery: Quiet,
    change_platform_profile_on_battery: false,
    platform_profile_on_ac: Performance,
    change_platform_profile_on_ac: false,
    profile_quiet_epp: Power,
    profile_balanced_epp: BalancePower,
    profile_custom_epp: Performance,
    profile_performance_epp: Performance,
    ac_profile_tunings: {
        Quiet: (
            enabled: false,
            group: {},
        ),
        Performance: (
            enabled: false,
            group: {},
        ),
        Balanced: (
            enabled: false,
            group: {},
        ),
    },
    dc_profile_tunings: {
        Balanced: (
            enabled: false,
            group: {},
        ),
        Performance: (
            enabled: false,
            group: {},
        ),
        Quiet: (
            enabled: false,
            group: {},
        ),
    },
    armoury_settings: {},
)